# 运行时数据（学生私有库 / 全局库 / 归档试卷）
data/
archive/

# 改造前全量备份（体积大，不入库；发布产物与运行数据同理）
backup/

# 编译产物（仅忽略仓库根与 dist/ 下的二进制，勿用裸名以免误伤 cmd/studybuddy/ 源码目录）
dist/
/studybuddy.exe
/studybuddy

# 仓库根下的一切可执行二进制与临时产物
# 逐个枚举易漏：distsbtest.exe、diststudybuddy.new.exe、verify-scratchsbtest.exe 均曾被提交，各 16 MB，
# 故按扩展名与后缀统一忽略。路径以 / 开头只作用于仓库根，不会误伤 cmd/studybuddy/ 源码目录。
# dist/ 目录已由上一条整体忽略，此处不再重复枚举。
/*.exe
/*.exe~
/*.old.exe
/*.new.exe

# 自检临时文件
smoke-test.docx

# Python 缓存（scripts/ 与技能脚本被 import 时生成）
__pycache__/
*.pyc

# 无头浏览器自检留下的 scratch 目录（脚本已用 --user-data-dir 指到临时目录，这里兜底）
verify-scratch/

# 教材内容 content/ 属于项目资产，默认入库（如需私有可取消下一行注释）
# content/

# 技能自测产物（直接运行引擎时输出到技能目录下的 out/）
.workbuddy/skills/interactive-quiz-html/out/
.workbuddy/skills/interactive-quiz-html/scripts/__pycache__/

# 内联脚本语法体检的落盘产物（tools/dumpjs 输出，供 node --check 用）
.tmp_js/

# 发版核对用：curl 抓下来的线上 CSS 快照（与磁盘 md5 比对，避免源码/二进制错位）
.tmp_live.css 
